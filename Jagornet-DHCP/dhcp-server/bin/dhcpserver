#!/bin/sh
#
# Jagornet DHCP Server Launcher
#

show_help() {
  cat << 'EOF'
Jagornet DHCP Server
Usage: dhcpserver [options]

Server Options:
  -c,  --configfile <filename>    Configuration file (default = config/dhcpserver.xml)
  -4b, --v4bcast <interface>      DHCPv4 broadcast interface (default = none)
  -4u, --v4ucast <addresses...>   DHCPv4 unicast addresses (default = all IPv4 addresses)
  -4p, --v4port <portnum>         DHCPv4 port number (default = 67)
  -6m, --v6mcast <interfaces...>  DHCPv6 multicast interfaces (default = none)
  -6u, --v6ucast <addresses...>   DHCPv6 unicast addresses (default = all IPv6 addresses)
  -6p, --v6port <portnum>         DHCPv6 port number (default = 547)
  -ga, --gaddr <address>          gRPC address (default = all IP addresses, or 'none')
  -gp, --gport <portnum>          gRPC port number (default = 9066)
  -ha, --haddr <address>          HTTPS address (default = all IP addresses, or 'none')
  -hp, --hport <portnum>          HTTPS port number (default = 9067)

Utility Options:
  -tc, --test-configfile <file>   Test configuration file syntax, then exit
  -li, --list-interfaces          Show detailed host interface list, then exit
  -v,  --version                  Show version information, then exit
  -?,  --help                     Show this help page

Service Management (systemd):
  systemctl start jagornet-dhcp    Start the server service
  systemctl stop jagornet-dhcp     Stop the server service
  systemctl restart jagornet-dhcp  Restart the server service
  systemctl status jagornet-dhcp   Check server status
  journalctl -u jagornet-dhcp -f   Follow service logs
EOF
}

# Fast intercept for help and empty arguments (< 5ms response, no JVM boot required)
if [ $# -eq 0 ]; then
  show_help
  exit 0
fi

case "$1" in
  "-?"|"-h"|"--help"|"help")
    show_help
    exit 0
    ;;
esac

# Resolve JAGORNET_DHCP_HOME
if [ -z "$JAGORNET_DHCP_HOME" ]; then
  PRG="$0"
  while [ -h "$PRG" ]; do
    ls=`ls -ld "$PRG"`
    link=`expr "$ls" : '.*-> \(.*\)$'`
    if expr "$link" : '/.*' > /dev/null; then
      PRG="$link"
    else
      PRG=`dirname "$PRG"`/"$link"
    fi
  done
  JAGORNET_DHCP_HOME=`dirname "$PRG"`/..
  JAGORNET_DHCP_HOME=`cd "$JAGORNET_DHCP_HOME" && pwd`
fi

# Locate Java executable
if [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ]; then
  JAVA="$JAVA_HOME/bin/java"
elif command -v java >/dev/null 2>&1; then
  JAVA="java"
else
  echo "Error: Java not found. Please set the JAVA_HOME environment variable or ensure 'java' is in your PATH." >&2
  exit 1
fi

# Backward compatibility / legacy command handling
case "$1" in
  start|run)
    shift
    ;;
  stop|status)
    echo "Note: The Jagornet DHCP server now runs as a foreground process."
    echo "If running as a systemd service, use:"
    echo "  sudo systemctl $1 jagornet-dhcp"
    echo "If running interactively, press Ctrl+C to stop."
    exit 1
    ;;
  restart)
    echo "Note: When running as a systemd service, use:"
    echo "  sudo systemctl restart jagornet-dhcp"
    exit 1
    ;;
  list-interfaces)
    shift
    set -- "--list-interfaces" "$@"
    ;;
  test-configfile)
    shift
    set -- "--test-configfile" "$@"
    ;;
  version)
    shift
    set -- "--version" "$@"
    ;;
  testclientv4|testclientv6|gentestconfig)
    CMD="$1"
    shift
    echo "Redirecting to $CMD... (Note: $CMD is now a standalone script in bin/$CMD)"
    exec "$JAGORNET_DHCP_HOME/bin/$CMD" "$@"
    ;;
esac

# Classpath setup
CLASSPATH="$JAGORNET_DHCP_HOME/config:$JAGORNET_DHCP_HOME/lib/*:$CLASSPATH"
export CLASSPATH

JAVA_OPTS="$JAVA_OPTS -server -Djava.awt.headless=true"

# Execute Java directly in foreground (signals like SIGTERM/SIGINT propagate cleanly)
exec "$JAVA" $JAVA_OPTS -Djagornet.dhcp.home="$JAGORNET_DHCP_HOME" \
     com.jagornet.dhcp.server.JagornetDhcpServer "$@"
